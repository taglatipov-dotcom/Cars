# ============================================================
# Шаблон настроек бэкенда ILSATAO.
# Скопируйте в src/.env и заполните:   cp src/.env.example src/.env
#
# • src/.env НЕ хранится в git и НЕ попадает в Docker-образ.
#   На сервере и на локальном компьютере — свои отдельные файлы.
# • Значения с символом $ (хеш пароля) и секреты берите
#   в ОДИНАРНЫЕ кавычки — иначе docker compose «съест» $.
# • Здесь только настройки. Пароли от сервера, заметки и команды
#   сюда не пишем.
# ============================================================

# --- Админка ---
# Хеш и секрет генерируются скриптом: python src/scripts/generate_admin_credentials.py
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH='$2b$12$замените_на_хеш'
JWT_SECRET_KEY='замените_на_длинный_случайный_секрет'
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# --- Калькулятор таможни (calcus.ru) ---
CALCUS_API_KEY=
API_CLIENT_ID=

# --- Почта: уведомления о новых заявках (Яндекс SMTP) ---
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USE_TLS=false
SMTP_USER=
SMTP_PASSWORD=''
SMTP_FROM=
SMTP_TO=

# --- Сайт ---
# Используется для ссылок в письмах. Локально можно http://localhost:5173
SITE_URL=https://ilsatao.ru
